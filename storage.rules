rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function hasRecentOwnerAuthentication() {
      return request.auth != null
        && request.auth.token.email == "maheriman6@gmail.com"
        && request.auth.token.auth_time is int
        && request.time.toMillis() >= request.auth.token.auth_time * 1000
        && request.time.toMillis() < request.auth.token.auth_time * 1000 + 3600000;
    }

    match /uploads/{file=**} {
      allow read: if true;
      allow create, update: if hasRecentOwnerAuthentication()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if hasRecentOwnerAuthentication();
    }
  }
}
